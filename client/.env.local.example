# Frontend (Next.js) — only what the client actually uses.
# All backend variables (Mongo, OpenRouter, Razorpay, VAPID private, cron)
# live in server/.env — the frontend calls the Express backend instead.

# Clerk — browser (public) + server-side (secret, used by Next middleware)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public VAPID key — the browser uses this to subscribe to web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Base URL of the standalone Express backend (server/)
NEXT_PUBLIC_API_URL=http://localhost:4000
