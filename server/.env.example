# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000

# ── Clerk Auth ──────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── MongoDB (same Atlas cluster as the current app) ─────────────────────
MONGODB_URI=

# ── OpenRouter AI ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Used as the HTTP-Referer header sent to OpenRouter
APP_URL=https://memomind.vercel.app

# ── Razorpay ────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_PLAN_ID_MONTHLY=plan_xxxxx
RAZORPAY_PLAN_ID_YEARLY=plan_xxxxx

# ── Web Push (VAPID) ────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=your-email@example.com

# ── Cron ────────────────────────────────────────────────────────────────
# Secret always required to call GET /api/cron/daily-reminders (401 if unset).
# GitHub Actions (.github/workflows/daily-reminder.yml) triggers it daily and
# must use the same value as its CRON_SECRET repo secret.
CRON_SECRET=
