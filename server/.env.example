# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000

# ── Clerk Auth ──────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── MongoDB (same Atlas cluster as the current app) ─────────────────────
MONGODB_URI=

# ── OpenRouter AI ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Used as the HTTP-Referer header sent to OpenRouter
APP_URL=https://memomind.vercel.app

# ── Razorpay ────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_PLAN_ID_MONTHLY=plan_xxxxx
RAZORPAY_PLAN_ID_YEARLY=plan_xxxxx

# ── Web Push (VAPID) ────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=your-email@example.com

# ── Cron ────────────────────────────────────────────────────────────────
CRON_SECRET=
# Run the daily reminder in-process via node-cron (true) or rely only on the
# protected HTTP endpoint being triggered externally (false)
ENABLE_CRON=true
